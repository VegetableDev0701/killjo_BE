# JWT Configuration
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRATION=24h
REFRESH_TOKEN_SECRET=your_refresh_token_secret
REFRESH_TOKEN_EXPIRATION=7d

# Email Configuration
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=noreply@yourdomain.com
EMAIL_PASS=your_email_password
EMAIL_FROM=Nodo.ia <noreply@yourdomain.com>

# For development, you can use Ethereal Email
# ETHEREAL_USER=ethereal_user
# ETHEREAL_PASS=ethereal_password

# Stripe Configuration
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# URLs
FRONTEND_URL=http://localhost:3001
API_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX=100           # 100 requests per 15 minutes

# Logging
LOG_LEVEL=debug

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://nodo-ia-admin.vercel.app
CRYPTO_SALT_ROUNDS=10
VERIFICATION_TOKEN_EXPIRY=86400000  # 24 hours in milliseconds
PASSWORD_RESET_TOKEN_EXPIRY=3600000 # 1 hour in milliseconds
TEAM_INVITE_TOKEN_EXPIRY=604800000  # 7 days in milliseconds

# Free Plan Configuration
FREE_PLAN_LISTING_LIMIT=5

# Promo Credits
SINGLE_CREDIT_PRICE=999
CREDIT_PACK_5_PRICE=3995
CREDIT_PACK_10_PRICE=6995

# OpenAI API key
OPENAI_API_KEY=add_openAi_api_here


# Apple Sign In & In-App Purchase credentials
APPLE_CLIENT_ID=your.apple.client.id.here
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_REDIRECT_URI=https://your-app-redirect-uri.com/callback

# Apple Private Key for In-App Purchases
# Option 1: Use APPLE_PRIVATE_KEY environment variable (recommended for deployed environments)
# Replace newlines with \n for environment variable
APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----
# Option 2: Place .p8 file in certificates/ directory as SubscriptionKey_{APPLE_KEY_ID}.p8

# Google Sign In credentials
# Get these from Google Cloud Console -> Credentials
GOOGLE_CLIENT_ID=your-google-web-client-id.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Optional: Separate client IDs for mobile platforms (if different)
GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your-ios-client-id.googleusercontent.com

# Google Play Billing (Android In-App Purchases)
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"..."}'

# Testing
